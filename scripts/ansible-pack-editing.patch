+private func canonicalStickerDocument(mimeType: String, attributes: inout [TelegramMediaFileAttribute]) -> String {
+    guard mimeType == "application/x-ansible-sticker" || mimeType == "application/x-tgsticker" else {
+        return mimeType
+    }
+    let original = fileNameFromFileAttributes(attributes) ?? ""
+    let stem = ((original as NSString).lastPathComponent as NSString).deletingPathExtension
+    attributes.removeAll { if case .FileName = $0 { return true }; return false }
+    attributes.append(.FileName(fileName: (stem.isEmpty ? "sticker" : stem) + ".ass"))
+    return "application/x-ansible-sticker"
+}
