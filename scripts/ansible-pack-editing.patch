+private func storeEditedStickerPack(transaction: Transaction, info: StickerPackCollectionInfo, items: [StickerPackItem]) {
+    var installed = transaction.getItemCollectionsInfos(namespace: info.id.namespace)
+    if let index = installed.firstIndex(where: { $0.0 == info.id }) {
+        installed[index] = (info.id, info)
+        transaction.replaceItemCollectionInfos(namespace: info.id.namespace, itemCollectionInfos: installed)
+        transaction.replaceItemCollectionItems(collectionId: info.id, items: items)
+    }
+    cacheStickerPack(transaction: transaction, info: info, items: items)
+}
+
+func _internal_setStickerPackCover(account: Account, packReference: StickerPackReference, fileId: Int64) -> Signal<Never, ReplaceStickerError> {
+    return account.network.request(Api.functions.stickers.setStickerSetThumb(flags: 2, stickerset: packReference.apiInputStickerSet, thumb: nil, thumbDocumentId: fileId))
+    |> mapError { _ -> ReplaceStickerError in .generic }
+    |> mapToSignal { result -> Signal<Never, ReplaceStickerError> in
+        guard let (info, items) = parseStickerSetInfoAndItems(apiStickerSet: result) else {
+            return .fail(.generic)
+        }
+        return account.postbox.transaction { transaction in
+            storeEditedStickerPack(transaction: transaction, info: info, items: items)
+        }
+        |> castError(ReplaceStickerError.self)
+        |> ignoreValues
+    }
+}
