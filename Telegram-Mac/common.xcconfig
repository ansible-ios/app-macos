SIMPLE_SLASH=/

WEBRTC_MAC = 1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) WEBRTC_MAC=$(WEBRTC_MAC)

ANSIBLE_API_ID = 0
ANSIBLE_API_HASH =
ANSIBLE_USE_APP_GROUP = NO
#include? "../configurations/Ansible.local.xcconfig"
